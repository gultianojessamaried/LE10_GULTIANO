
#include <stdio.h>
#include <string.h>

int main() {
    FILE *fp;
    int id, choice;
    char name[100];
    char section[50];

    do {
        printf("Enter Student Number: ");
        scanf("%d", &id);
        getchar();

        printf("Enter Complete Name: ");
        fgets(name, sizeof(name), stdin);
        name[strcspn(name, "\n")] = '\0';

        printf("Enter Section: ");
        fgets(section, sizeof(section), stdin);
        section[strcspn(section, "\n")] = '\0';

        fp = fopen("student_records.txt", "a");

        if (fp == NULL) {
            printf("Error opening file!\n");
            return 1;
        }

        fprintf(fp, "ID Number: %d\n", id);
        fprintf(fp, "Complete Name: %s\n", name);
        fprintf(fp, "Section: %s\n\n", section);

        fclose(fp);

        printf("\nRecord added and saved successfully.\n");

        printf("\nAdd another student? [Enter 1 for Yes, 0 for No]: ");
        scanf("%d", &choice);

        printf("\n");

    } while (choice == 1);

    printf("All student records have been saved.\n");

    // Read and display student_records.txt
    fp = fopen("student_records.txt", "r");

    if (fp != NULL) {
        char line[200];

        printf("\n--- STUDENT RECORDS ---\n");

        while (fgets(line, sizeof(line), fp) != NULL) {
            printf("%s", line);
        }

        fclose(fp);
    }

    return 0;
}
